# Server-side only. Never commit actual values.
RECOGNITIUM_API_KEY=
# Separate random capabilities of at least 24 characters for this local prototype.
# They are not wallet seeds. Browser account labels grant no authority.
PROTOTYPE_BROKER_TOKEN=
PROTOTYPE_BORROWER_TOKEN=
PROTOTYPE_OPERATOR_TOKEN=
PORT=3000
# Set only for the founder-relayed mentor trial on event network 4001.
TRACK1_MENTOR_OPEN_ENDED_TRIAL=0
# Optional background READ-ONLY service checks every 30 seconds.
DASHBOARD_LIVE_CHECKS=0
# Private storage roots can isolate automated tests or a separate demo instance.
# Omit for the existing data/ and wallets/ directories. Never share them via git.
# RECOGNITIUM_DATA_DIR=
# RECOGNITIUM_WALLET_DIR=
